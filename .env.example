# Copie para .env e preencha. O arquivo .env nunca deve ser commitado.

# --- Chaves de API (obrigatória ao menos a do provider principal)
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# --- Providers
OPTIMUS_PRIMARY_PROVIDER=gemini
OPTIMUS_PRIMARY_MODEL=gemini-2.5-pro
OPTIMUS_SECONDARY_PROVIDER=claude
# OPTIMUS_SECONDARY_MODEL=

# --- Execução
OPTIMUS_LOG_LEVEL=INFO
OPTIMUS_REQUEST_TIMEOUT_SECONDS=120
